# Same values your current server already uses (keep MONGODB_URI and JWT_SECRET identical so
# existing users keep working).
MONGODB_URI=mongodb+srv://...
JWT_SECRET=change-me-long-random
# Shared secret for the optional scheduler ping to POST /api/admin/sweep
SWEEP_KEY=change-me-too
# Optional policy overrides (defaults shown)
# TZ_OFFSET_MIN=330
# FLAP_MIN=10
# STALE_MIN=45
# BRIDGE_MIN=180
# GRACE_MIN=15
# MAX_SESSION_H=16
# LUNCH_DEDUCT_MIN=0
# MIN_RADIUS_M=100
